# Optional Hugging Face token for model downloads.
# Set this in your RunPod environment variables.
HF_TOKEN=

# Optional CivitAI token.
# Set this in your RunPod environment variables.
CIVITAI_API_TOKEN=

# Comma-separated CivitAI model version IDs to download automatically.
CIVITAI_LORAS=2200329,2846342,2621242,2858760,3229050,2497207,3228867,2840146,3220766,2834417,3268303,3152083,3206518,3088013,2856467,3266628,3150341

# Destination for automatically downloaded CivitAI LoRAs.
CIVITAI_LORA_DIR=/workspace/ComfyUI/models/loras

# MiniMax H3 model settings.
DOWNLOAD_H3_MODELS=true
DOWNLOAD_TURBO_LORA=true
DEFAULT_H3_QUANT=int8
H3_HF_REPO=Comfy-Org/MiniMax-H3

# Optional additional Hugging Face LoRAs.
#
# Format:
# H3_EXTRA_HF_LORAS=owner/repo:path/model.safetensors;other/repo:path/model.safetensors
H3_EXTRA_HF_LORAS=

# ComfyUI
COMFYUI_PORT=8188
COMFYUI_DIR=/workspace/ComfyUI
