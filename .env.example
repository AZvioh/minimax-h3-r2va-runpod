# Optional Hugging Face token
HF_TOKEN=

# MiniMax H3
DOWNLOAD_H3_MODELS=true
DOWNLOAD_TURBO_LORA=true
DEFAULT_H3_QUANT=int8
H3_HF_REPO=Comfy-Org/MiniMax-H3

# Optional additional Hugging Face LoRAs
H3_EXTRA_HF_LORAS=

# CivitAI
#
# CivitAI downloads are NOT performed automatically during startup.
# These variables can still be used when manually running:
#
# /opt/h3-template/scripts/download_civitai_loras.sh
#
CIVITAI_API_TOKEN=
CIVITAI_LORAS=
CIVITAI_LORA_DIR=/workspace/ComfyUI/models/loras

# ComfyUI
COMFYUI_PORT=8188
COMFYUI_DIR=/workspace/ComfyUI

# JupyterLab
JUPYTER_PORT=8888

# Optional fixed token.
# If empty, the container generates one and stores it at:
# /workspace/jupyter_token.txt
JUPYTER_TOKEN=

# Automatic state backup
QUEUE_BACKUP_INTERVAL=5
INPUT_BACKUP_INTERVAL=60
